rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && request.auth.token.get('role', 'participant') in ['admin', 'superadmin']; }
    function isSuperadmin() { return signedIn() && request.auth.token.get('role', 'participant') == 'superadmin'; }
    function ownsClub(clubId) {
      return signedIn() && firestore.get(/databases/(default)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid;
    }
    function ownsEvent(eventId) {
      return signedIn() && firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
    }
    // Event photos: public to read; only the event's organiser or an admin can change them.
    match /events/{eventId}/{file} {
      allow read: if true;
      allow create, update: if (ownsEvent(eventId) || isStaff())
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if ownsEvent(eventId) || isStaff();
    }
    // Club cover images: public to read; only the club's owner or an admin can change them.
    match /clubs/{clubId}/{file} {
      allow read: if true;
      allow create, update: if (ownsClub(clubId) || isStaff())
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if ownsClub(clubId) || isStaff();
    }
    // Evidence photos: only people with an accepted registration can upload, into their own folder, once (no overwrite, no delete).
    // Only the person, the event's organiser and admins can read them.
    match /evidence/{eventId}/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || ownsEvent(eventId) || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
        && file.matches('[A-Za-z0-9]{10,40}[.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && firestore.get(/databases/(default)/documents/events/$(eventId)/registrations/$(uid)).data.status in ['Accepted', 'On site'];
      allow update, delete: if false;
    }
    // Profile pictures: public to read; each person can only change their own.
    match /avatars/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Placeholder pictures: public to read; only a superadmin can change them.
    match /placeholders/{file} {
      allow read: if true;
      allow create, update: if isSuperadmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSuperadmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
