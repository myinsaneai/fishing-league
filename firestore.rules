rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', 'participant'); }
    function isStaff() { return signedIn() && role() in ['admin', 'superadmin']; }
    function isOrganiser() { return signedIn() && role() in ['organiser', 'admin', 'superadmin']; }
    // Review outcome fields can only be written by admins.
    function ev(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data; }
    function isOrganiserOf(eventId) { return signedIn() && ev(eventId).ownerId == request.auth.uid; }
    function noReviewFields(d) { return !d.keys().hasAny(['reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason']); }
    function reviewUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason']); }
    // Clubs made before approvals existed have no status and count as approved.
    function clubStatus(d) { return d.get('status', 'approved'); }
    function ownerEventStatusOk(oldS, newS) {
      return (oldS in ['draft', 'pending', 'rejected'] && newS in ['draft', 'pending'])
        || (oldS in ['published', 'cancelled'] && newS in ['published', 'cancelled']);
    }
    function mapOk(d) {
      return d.get('mapUrl', '').size() <= 1000
        && (d.get('lat', null) == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (d.get('lng', null) == null || (d.lng is number && d.lng >= -180 && d.lng <= 180));
    }
    function clubOk(d) {
      return d.keys().hasOnly(['name', 'tagline', 'description', 'region', 'town', 'waterTypes', 'disciplines', 'email', 'website', 'social', 'founded', 'meetings', 'coverUrl', 'ownerId', 'ownerName', 'createdAt', 'updatedAt', 'status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason', 'mapUrl', 'lat', 'lng'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.get('tagline', '').size() <= 120
        && d.get('description', '').size() <= 1500
        && d.get('town', '').size() <= 60
        && d.get('meetings', '').size() <= 200
        && d.waterTypes is list && d.waterTypes.size() >= 1 && d.waterTypes.hasOnly(['Sea', 'Freshwater'])
        && d.get('disciplines', []) is list
        && clubStatus(d) in ['pending', 'approved', 'rejected']
        && d.get('rejectionReason', '').size() <= 300
        && mapOk(d);
    }
    // Keep the discipline list in step with DISC in src/data.js.
    function eventOk(d) {
      return d.keys().hasOnly(['name', 'kind', 'registrationCloses', 'description', 'waterType', 'discipline', 'disciplineOther', 'format', 'region', 'district', 'waterbody', 'meetingPoint', 'startsAt', 'endsAt', 'fee', 'limit', 'clubId', 'status', 'coverUrl', 'ownerId', 'ownerName', 'createdAt', 'updatedAt', 'counts', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason', 'mapUrl', 'lat', 'lng'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 100
        && d.get('kind', 'tournament') in ['tournament', 'seminar']
        && d.get('registrationCloses', 'start') in ['start', 'end']
        && d.get('description', '').size() <= 2000
        && d.waterType in ['Sea', 'Freshwater']
        && d.discipline in ['Fly', 'Spin', 'Surfcasting', 'Boat', 'Kayak', 'Other']
        && d.get('disciplineOther', '').size() <= 30
        && d.format in ['Individual', 'Team']
        && d.region is string && d.region.size() <= 40
        && d.get('district', '').size() <= 40
        && d.waterbody is string && d.waterbody.size() >= 2 && d.waterbody.size() <= 80
        && d.get('meetingPoint', '').size() <= 120
        && d.startsAt is timestamp
        && (d.get('endsAt', null) == null || (d.endsAt is timestamp && d.endsAt > d.startsAt))
        && d.fee is number && d.fee >= 0 && d.fee <= 10000
        && d.limit is int && d.limit >= 1 && d.limit <= 2000
        && d.status in ['draft', 'pending', 'published', 'rejected', 'cancelled']
        && d.get('rejectionReason', '').size() <= 300
        && d.get('coverUrl', '') is string
        && mapOk(d);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled']);
      allow delete: if false;
    }
    match /clubs/{clubId} {
      allow read: if clubStatus(resource.data) == 'approved'
        || (signedIn() && (resource.data.ownerId == request.auth.uid || isStaff()));
      allow create: if isOrganiser() && clubOk(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (isStaff() || (request.resource.data.status == 'pending' && noReviewFields(request.resource.data)));
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isStaff())
        && clubOk(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (isStaff() || (reviewUnchanged()
          && (clubStatus(request.resource.data) == clubStatus(resource.data)
            || (clubStatus(resource.data) == 'rejected' && clubStatus(request.resource.data) == 'pending'))));
      // Deleting a club is done by the deleteClub function (it also cleans up what belongs to it), never from the browser.
      allow delete: if false;
    }
    match /events/{eventId} {
      allow read: if resource.data.status in ['published', 'cancelled']
        || (signedIn() && (resource.data.ownerId == request.auth.uid || isStaff()));
      allow create: if isOrganiser() && eventOk(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !('counts' in request.resource.data)
        && (isStaff() || (request.resource.data.status in ['draft', 'pending'] && noReviewFields(request.resource.data)));
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || isStaff())
        && eventOk(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('counts', null) == resource.data.get('counts', null)
        && (isStaff() || (reviewUnchanged() && ownerEventStatusOk(resource.data.status, request.resource.data.status)));
      // Admins delete events with the deleteEvent function (it also removes registrations, evidence and pictures). An owner can still drop an untouched draft.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid && resource.data.status == 'draft';
    }
    // Registrations are only written by the registration Cloud Functions, never by the browser.
    // Public part (names only): readable by everyone once the event is public; the organiser, admins and the person themselves can always read it.
    match /events/{eventId}/registrations/{uid} {
      allow read: if ev(eventId).status in ['published', 'cancelled'] || isOrganiserOf(eventId) || isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    // Private part (phone and email): the organiser, admins and the person themselves only.
    match /events/{eventId}/registrationPrivate/{uid} {
      allow read: if isOrganiserOf(eventId) || isStaff() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    // Evidence photos: records are only written by the evidence Cloud Functions. They carry the position read from the photo,
    // so only the person who sent it, the event's organiser and admins can read them.
    match /events/{eventId}/evidence/{id} {
      allow read: if isOrganiserOf(eventId) || isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    // Requests to become an organiser: only the functions write them; the person reads their own, admins read all.
    match /roleRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }
    // Each person's own list of their registrations (for My page).
    match /users/{uid}/registrations/{eventId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Site-wide settings. Only the placeholder pictures exist so far; everyone can read them, only a superadmin can change them.
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if signedIn() && role() == 'superadmin' && docId == 'placeholders'
        && request.resource.data.keys().hasOnly(['avatar', 'club', 'event', 'updatedAt'])
        && request.resource.data.get('avatar', '') is string && request.resource.data.get('avatar', '').size() <= 1000
        && request.resource.data.get('club', '') is string && request.resource.data.get('club', '').size() <= 1000
        && request.resource.data.get('event', '') is string && request.resource.data.get('event', '').size() <= 1000;
      allow delete: if false;
    }
  }
}
